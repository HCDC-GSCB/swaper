"    page-layout: custom",
"    include-in-header: ",
"      - text: |",
"          <script src=\"../highcharts.js\"></script>",
"          <script src=\"../highcharts-more.js\"></script>",
"---"
)
writeLines(c(yaml_header, current_tpl), post_filename)
