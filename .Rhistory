tpl_lines_clean <- c(hide_title_css, tpl_lines_clean)
weeks_to_generate <- agg_sxh %>% filter(Year == 2026, Week <= 11) %>% select(Year, Week) %>% distinct()
for (i in 1:nrow(weeks_to_generate)) {
y <- weeks_to_generate$Year[i]; w <- weeks_to_generate$Week[i]
current_tpl <- str_replace_all(tpl_lines_clean, "\\{\\{TARGET_YEAR\\}\\}", as.character(y))
current_tpl <- str_replace_all(current_tpl, "\\{\\{TARGET_WEEK\\}\\}", as.character(w))
dummy_date <- as.Date(paste(y, w, 5, sep="-"), "%Y-%W-%u")
yaml_header <- c(
"---", sprintf("title: 'Bản tin nhanh - Tuần %02d/%d'", w, y),
sprintf("date: '%s'", dummy_date), "image: /logo.png",
"format:", "  html:", "    css: ../snapshot.css", "    page-layout: custom",
"    include-in-header: ", "      - text: |",
"          <script src=\"../highcharts.js\"></script>",
"          <script src=\"../highcharts-more.js\"></script>",
