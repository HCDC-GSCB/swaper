}
message("🎉 Xong 11 tuần! Gõ 'quarto preview snapshot/' để chiêm ngưỡng giao diện mới.")
# ==============================================================================
# CHẠY 1 LẦN: VÉT LỊCH SỬ TỪ TUẦN 1 ĐẾN TUẦN 11 NĂM 2026
# ==============================================================================
message("--- Đang tạo lại lịch sử tuần 1 đến 11 ---")
library(dplyr)
library(stringr)
# Xác định đường dẫn
base_path <- if (dir.exists("dashboard")) "dashboard/" else ""
posts_dir <- paste0(base_path, "../snapshot/posts/")
if (!dir.exists(posts_dir)) dir.create(posts_dir, recursive = TRUE)
# Lấy Khuôn mẫu
tpl_path <- paste0(base_path, "../snapshot/template.qmd")
tpl_lines <- readLines(tpl_path, warn = FALSE)
start_idx <- which(tpl_lines == "---")[2]
tpl_lines_clean <- tpl_lines[(start_idx + 1):length(tpl_lines)]
# Lọc data từ tuần 1 đến tuần 11 năm 2026
weeks_to_generate <- agg_sxh %>%
filter(Year == 2026, Week <= 11) %>%
select(Year, Week) %>%
distinct()
# Vòng lặp đẻ file
for (i in 1:nrow(weeks_to_generate)) {
y <- weeks_to_generate$Year[i]
w <- weeks_to_generate$Week[i]
post_filename <- sprintf("%s%d_W%02d.qmd", posts_dir, y, w)
# Bơm số vào khuôn
current_tpl <- str_replace_all(tpl_lines_clean, "\\{\\{TARGET_YEAR\\}\\}", as.character(y))
current_tpl <- str_replace_all(current_tpl, "\\{\\{TARGET_WEEK\\}\\}", as.character(w))
dummy_date <- as.Date(paste(y, w, 5, sep="-"), "%Y-%W-%u")
if (is.na(dummy_date)) dummy_date <- Sys.Date()
# Gói YAML tinh gọn, chuẩn giao diện mới
yaml_header <- c(
"---",
sprintf("title: 'Bản tin nhanh - Tuần %02d/%d'", w, y),
sprintf("description: 'Cập nhật tình hình SXH và TCM tuần %02d năm %d'", w, y),
sprintf("date: '%s'", dummy_date),
"image: /favicon.png",
"format:",
"  html:",
"    css: ../snapshot.css",
"    page-layout: custom",
"    include-in-header: ",
"      - text: |",
"          <script src=\"../highcharts.js\"></script>",
"          <script src=\"../highcharts-more.js\"></script>",
"---"
)
writeLines(c(yaml_header, current_tpl), post_filename)
message(sprintf("✅ Đã đẻ thành công: %d_W%02d.qmd", y, w))
}
message("🎉 Xong 11 tuần! Gõ 'quarto preview snapshot/' để chiêm ngưỡng giao diện mới.")
